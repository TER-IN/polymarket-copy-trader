TARGET_WALLETS=0x0000000000000000000000000000000000000000
COPY_MODE=dry_run
POLL_INTERVAL_SECONDS=10
DATABASE_URL=sqlite:///polymarket_copy_trader.sqlite3
TRADING_DAY_TIMEZONE=Europe/Berlin
SEED_EXISTING_TRADES_ON_STARTUP=true
SOURCE_POSITION_POLICY=skip_preexisting
SELL_SIZING_MODE=source_position_ratio
ON_RISK_MISMATCH=freeze_token
RISK_MISMATCH_SCOPE=token
SOURCE_POSITION_SIZE_THRESHOLD=0.01
OUTCOME_SELECTION_MODE=source

MAX_TRADE_USD=25
COPY_RATIO=0.25
INVERSE_SHARE_COPY_RATIO=0.10
MAX_SLIPPAGE_CENTS=2
MAX_BUY_PRICE=0.97
MAX_SECONDS_UNTIL_MARKET_END=129600
MARKET_TYPE_FILTER=all
UP_DOWN_MIN_DURATION_SECONDS=200
UP_DOWN_MAX_DURATION_SECONDS=3700
MIN_NET_UPSIDE_USD=
MIN_NET_UPSIDE_PERCENT=
NET_UPSIDE_SAFETY_MARGIN_USD=0
INCLUDE_EXIT_FEE_IN_UPSIDE=false
MIN_TRADE_USD=1
MAX_TRADE_AGE_SECONDS=120
ALLOW_MARKET_CATEGORIES=
ALLOW_MARKET_TITLE_KEYWORDS=
BLOCK_MARKET_KEYWORDS=

ENABLE_CROWDING_CHECK=true
CROWDING_LOOKBACK_SECONDS=180
CROWDING_MAX_FOLLOWERS=5
ENABLE_RESOLUTION_SCANNER=true
RESOLUTION_SCAN_INTERVAL_SECONDS=60

# Empty, none, or unlimited disables this cap.
DAILY_SPEND_CAP_USD=100
PER_MARKET_EXPOSURE_CAP_USD=50
DRY_RUN_STARTING_BALANCE_USD=3000
ALLOW_COPY_RATIO_GT_ONE=false
ALLOW_SHORT_SELLS=false
STOP_TRADING_FILE=STOP_TRADING

